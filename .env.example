# ---------- Core ----------
APP_ENV=development                 # development | production
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Fernet key for encrypting customer API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000      # public URL of the API; used in the widget snippet (<script src=BACKEND_URL/widget.js>)
COOKIE_SECURE=false                 # must be true in production (HTTPS)
SESSION_TTL_HOURS=336

# ---------- Database / Redis ----------
DATABASE_URL=postgresql+asyncpg://omnibrain:omnibrain@postgres:5432/omnibrain
REDIS_URL=redis://redis:6379/0

# ---------- Google OAuth (only auth method) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The dashboard proxies /api/* to the backend, so the callback goes through the dashboard's own origin
# (keeps cookies first-party). Register this exact URL in the Google Cloud console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---------- LLM (platform-managed keys; workspaces may bring their own) ----------
LLM_PROVIDER=openai                 # openai | grok | anthropic
LLM_MODEL=                          # set to a model your provider account supports
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------- Embeddings (Anthropic has no embeddings API) ----------
EMBEDDING_PROVIDER=openai           # openai | local
EMBEDDING_MODEL=                    # e.g. an OpenAI embedding model or a sentence-transformers name
EMBEDDING_DIMENSIONS=1536           # must match the model; fixed per vector collection

# ---------- Vector store ----------
VECTOR_STORE=qdrant                 # qdrant | pinecone | pgvector
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=

# ---------- Storage / uploads ----------
STORAGE_PROVIDER=local
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=25

# ---------- Widget / abuse prevention ----------
WIDGET_TOKEN_TTL_HOURS=6
TRUSTED_PROXIES=0                   # number of reverse proxies in front of the API (for client IPs)
RL_FRAME_IP_PER_MIN=60
RL_WIDGET_IP_PER_MIN=30
RL_WIDGET_VISITOR_PER_MIN=20
RL_WIDGET_WORKSPACE_PER_MIN=300
RL_DASHBOARD_CHAT_PER_MIN=30

# ---------- Voice (optional) ----------
STT_PROVIDER=openai
STT_MODEL=
TTS_PROVIDER=openai
TTS_MODEL=
TTS_VOICE=alloy
MAX_VOICE_UPLOAD_MB=5

# ---------- Operations ----------
LOG_FORMAT=                         # json | text   (default: json in production, text in development)
METRICS_TOKEN=                      # /metrics returns 404 unless set; then needs "Authorization: Bearer <token>"
MAX_JSON_BODY_KB=1024
# Optional cost estimates (USD per 1M input/output tokens). Prices are not bundled because they change:
# MODEL_PRICING_JSON={"openai:<model>": [0.15, 0.60], "anthropic:<model>": [3, 15]}
# ENCRYPTION_KEY accepts several comma-separated keys for rotation: first encrypts, all decrypt.
